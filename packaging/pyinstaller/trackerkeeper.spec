# -*- mode: python ; coding: utf-8 -*-
# PyInstaller onedir spec for tracker keeper. GENERATED by `trackerkeeper bake` from
# [tool.trackerkeeper.metadata] — edit the template, never this file. One spec for both
# frozen targets:
#   Linux   → the onedir the .deb stages under /opt/trackerkeeper + the AppImage wraps.
#   Windows → the windowed onedir Inno Setup / the portable zip wrap, with the
#             generated .ico + version_info.txt (built by release.yml before this).
#
# Run from the repo root:  pyinstaller packaging/pyinstaller/trackerkeeper.spec --noconfirm
import os
import sys

from PyInstaller.utils.hooks import collect_data_files

# SPECPATH is the spec's own directory (packaging/pyinstaller); ROOT is the repo.
HERE = SPECPATH
ROOT = os.path.dirname(os.path.dirname(HERE))

# Ship the brand SVG (resolved at runtime via importlib.resources) + the license
# + the KWin drag_repaint effect payload (metadata.json + main.js) —
# drag_repaint/_kwin.py resolves it relative to __file__, which holds in a
# frozen bundle only if the files are collected at the same relative path.
datas = collect_data_files("trackerkeeper", includes=["assets/*.svg", "drag_repaint/effect/*",
                                                     # the phone interface's screens —
                                                     # loaded from disk by QML, so they
                                                     # must sit beside the package
                                                     "quick/qml/*.qml"])
datas += [(os.path.join(ROOT, "LICENSE"), ".")]

# Linux bundles (deb / AppImage) carry Qt Quick for the phone interface
# (trackerkeeper/quick — the default on an undocked Plasma Mobile / Phosh
# session). Windows / macOS keep pruning it: no phone shell there. Without it
# a frozen build on a phone silently falls back to the desktop window.
QUICK_UI = sys.platform.startswith("linux")
hiddenimports = []
if QUICK_UI:
    hiddenimports += ["PySide6.QtQml", "PySide6.QtQuick", "PySide6.QtQuickControls2"]

a = Analysis(
    [os.path.join(HERE, "launch.py")],
    pathex=[ROOT],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    runtime_hooks=[],
    excludes=[
        # Heavy Qt modules the chrome never imports — keeps the bundle lean. A
        # fork that uses any of these removes it from this list.
        "tkinter",
        "PySide6.QtWebEngineCore",
        "PySide6.QtWebEngineWidgets",
        *([] if QUICK_UI else ["PySide6.QtQuick", "PySide6.QtQml"]),
        "PySide6.Qt3DCore",
        "PySide6.QtCharts",
        "PySide6.QtDataVisualization",
        "PySide6.QtPdf",
    ],
    noarchive=False,
)
# --- Linux: keep only the QML the phone interface imports ------------------
# PySide6's QtQml hook collects the whole qml/ tree — Quick3D, WebEngine,
# Charts, Location, every Controls style — and the Qt libraries those plugins
# link (~290 MB measured on jellytoast). trackerkeeper/quick/qml imports
# QtQuick, QtQuick.Controls (Basic style) and QtQuick.Window; keep those (+
# what they load: Templates, Controls/impl, QtQml, and Layouts / Effects as
# cheap headroom) and drop the rest. Ported from jellytoast's spec.
if QUICK_UI:
    def _qml_rel(dest):
        dest = dest.replace(os.sep, "/")
        marker = "PySide6/Qt/qml/"
        i = dest.find(marker)
        return dest[i + len(marker):].split("/") if i >= 0 else None

    def _qml_keep(parts):
        if parts[0] == "QtQml":
            return len(parts) < 3 or parts[1] != "StateMachine"
        if parts[0] != "QtQuick":
            return False
        if len(parts) == 2:  # QtQuick's own qmldir / plugin
            return True
        if parts[1] in ("Layouts", "Effects", "Templates", "Window"):
            return True
        if parts[1] == "Controls":
            return len(parts) == 3 or parts[2] in ("Basic", "impl")
        return False

    def _qml_prunable(dest):
        parts = _qml_rel(dest)
        return parts is not None and not _qml_keep(parts)

    # Qt libraries only the pruned QML modules use.
    _QML_ONLY_LIB_STEMS = tuple(
        f"libQt6{m}"
        for m in (
            "Quick3D", "Charts", "Graphs", "DataVisualization", "Location",
            "WebEngine", "WebView", "WebChannel", "WebSockets", "Positioning",
            "Sensors", "Scxml", "StateMachine", "RemoteObjects", "TextToSpeech",
            "3D", "QuickTest", "SpatialAudio", "Core5Compat", "QuickParticles",
            "QuickTimeline", "QuickVectorImage", "QuickDialogs2", "QmlLocalStorage",
            "QmlXmlListModel", "MultimediaQuick", "QuickControls2Material",
            "QuickControls2Universal", "QuickControls2Imagine", "QuickControls2Fusion",
            "QuickControls2FluentWinUI3", "LabsAnimation", "LabsFolderListModel",
            "LabsQmlModels", "LabsSettings", "LabsSharedImage", "LabsWavefrontMesh",
            "ShaderTools", "QmlDesignSupport", "QmlCompiler", "VirtualKeyboard",
        )
    )

    def _lib_prunable(dest):
        return os.path.basename(dest).startswith(_QML_ONLY_LIB_STEMS)

    _n_before = len(a.binaries) + len(a.datas)
    a.binaries = [b for b in a.binaries if not (_qml_prunable(b[0]) or _lib_prunable(b[0]))]
    a.datas = [d for d in a.datas if not _qml_prunable(d[0])]
    print(f"trackerkeeper.spec: pruned {_n_before - len(a.binaries) - len(a.datas)} "
          "QML files / libraries the phone interface doesn't use")

pyz = PYZ(a.pure)

# Windows: stamp the generated icon + VSVersionInfo when release.yml produced them.
exe_kwargs = {}
if sys.platform == "win32":
    _ico = os.path.join(ROOT, "packaging", "windows", "trackerkeeper.ico")
    if os.path.exists(_ico):
        exe_kwargs["icon"] = _ico
    _ver = os.path.join(ROOT, "packaging", "windows", "version_info.txt")
    if os.path.exists(_ver):
        exe_kwargs["version"] = _ver
# macOS: build a SINGLE universal2 (arm64 + x86_64) binary so ONE .dmg + one
# Homebrew cask serve both Apple Silicon and Intel Macs. This needs a
# universal2 wheel for every compiled dependency (PySide6 ships them). The
# PER-ARCH FALLBACK — two native builds → two -macos-<arch>.dmg files with
# on_arm/on_intel sha256 blocks in the cask — is for a fork whose deps are
# thin-only (e.g. numpy/cffi with no universal2 wheel), where --target-arch
# universal2 aborts on the thin binaries.
elif sys.platform == "darwin":
    exe_kwargs["target_arch"] = "universal2"

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="trackerkeeper",
    debug=False,
    strip=False,
    upx=False,
    console=False,  # GUI app — no console window on Windows
    **exe_kwargs,
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name="trackerkeeper",
)

# macOS: wrap the onedir in a .app bundle (the .dmg + Homebrew cask ship this).
# The .icns is generated from the brand SVG by macos.yml; absent it, PyInstaller
# falls back to its default icon.
if sys.platform == "darwin":
    _icns = os.path.join(ROOT, "packaging", "macos", "trackerkeeper.icns")
    app = BUNDLE(
        coll,
        name="trackerkeeper.app",  # match macos.yml + the cask; no spaces for the shell
        icon=_icns if os.path.exists(_icns) else None,
        bundle_identifier="com.wolfgangwarehaus.trackerkeeper",
        info_plist={
            "CFBundleShortVersionString": "0.0.0",
            "CFBundleVersion": "0.0.0",
            "NSHighResolutionCapable": True,
            # CI-OVERWRITTEN PLACEHOLDER — macos.yml pins the bundle's REAL macOS
            # floor into Contents/Info.plist after freezing, via PlistBuddy
            #   "Set :LSMinimumSystemVersion <floor>"
            # (the honest-floor pin), so LaunchServices shows an honest "needs
            # macOS X" instead of a silent dock-bounce on an older system. 11.0
            # (Big Sur) is the universal2 baseline and the default a local,
            # un-pinned build ships.
            "LSMinimumSystemVersion": "11.0",
            # A fork maps its freedesktop categories to the right UTI here.
            "LSApplicationCategoryType": "public.app-category.developer-tools",
        },
    )

